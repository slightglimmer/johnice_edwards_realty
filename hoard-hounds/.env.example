# Where quote requests are sent. See README.md -> "Receiving quote requests".
#   netlify  - Netlify Forms (set automatically by netlify.toml when deployed on Netlify)
#   endpoint - POST to VITE_FORM_ENDPOINT (Formspree, Basin, Getform, or your own API)
#   demo     - nothing is sent; the form shows a "preview mode" notice (default)
VITE_FORM_PROVIDER=demo

# Only used when VITE_FORM_PROVIDER=endpoint, e.g. https://formspree.io/f/abcdwxyz
VITE_FORM_ENDPOINT=
